	hierarchy 'Date Hierarchy'
		lineageTag: 3f7c5d86-96c9-493d-bac8-be53cede7cff

		level Year
			ordinal: 0
			column: Year
			lineageTag: 792d9e87-f3f4-4b25-b75d-d9832ad5d41e

		level Quarter
			ordinal: 1
			column: Quarter
			lineageTag: cc44e1ed-de12-4b75-93e2-8e11d4949cf9

		level Month
			ordinal: 2
			column: MonthName
			lineageTag: 3a9b3175-17d8-478b-9941-ece95def77d8

