      "tableau_calculation": "Campaign ROI",
      "source_formula": "(SUM([deal_value]) - SUM([spend])) / SUM([spend])",
      "pbi_table": "Campaigns",
      "pbi_object": "Campaign ROI",
      "pbi_type": "measure",
      "source_status": "exact"
    },
    {
      "tableau_calculation": "Cost Per Lead",
      "source_formula": "SUM([spend]) / COUNTD([lead_id])",
      "pbi_table": "Campaigns",
      "pbi_object": "Cost Per Lead",
      "pbi_type": "measure",
      "source_status": "exact"
    },
    {
      "tableau_calculation": "Window Best ROI",
      "source_formula": "WINDOW_MAX((SUM([deal_value]) - SUM([spend])) / SUM([spend]))",
      "pbi_table": "Campaigns",
      "pbi_object": "Window Best ROI",
      "pbi_type": "measure",
      "source_status": "exact"
    },
    {
      "tableau_calculation": "Window Worst ROI",
