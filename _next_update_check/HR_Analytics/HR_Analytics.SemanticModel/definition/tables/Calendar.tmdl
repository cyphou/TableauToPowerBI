	hierarchy 'Date Hierarchy'
		lineageTag: 50206efb-4093-4bae-875f-ca909daa5af3

		level Year
			ordinal: 0
			column: Year
			lineageTag: 81a08b2b-97ac-49d1-8688-795455b634e5

		level Quarter
			ordinal: 1
			column: Quarter
