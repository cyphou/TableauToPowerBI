  "calculations": [
    {
      "tableau_calculation": "Gross Revenue",
      "source_formula": "SUM([quantity] * [unit_price])",
      "pbi_table": "fact_sales",
      "pbi_object": "Gross Revenue",
      "pbi_type": "measure",
      "source_status": "exact"
    },
    {
      "tableau_calculation": "Net Revenue",
      "source_formula": "SUM(IF [order_status] != \"Cancelled\" AND [is_returned] = FALSE THEN [quantity] * [unit_price] * (1 - [discount_pct]) ELSE 0 END)",
      "pbi_table": "fact_sales",
      "pbi_object": "Net Revenue",
      "pbi_type": "measure",
      "source_status": "exact"
    },
    {
      "tableau_calculation": "COGS",
      "source_formula": "SUM([quantity] * [unit_cost])",
      "pbi_table": "fact_sales",
      "pbi_object": "COGS",
      "pbi_type": "measure",
      "source_status": "exact"
    },
    {
      "tableau_calculation": "Gross Profit",
      "source_formula": "[C_NetRev] - [C_COGS] - SUM([shipping_cost])",
      "pbi_table": "fact_sales",
      "pbi_object": "Gross Profit",
      "pbi_type": "measure",
      "source_status": "exact"
    },
    {
      "tableau_calculation": "Gross Margin %",
      "source_formula": "ZN([C_GrossProfit] / [C_NetRev])",
      "pbi_table": "fact_sales",
      "pbi_object": "Gross Margin %",
      "pbi_type": "measure",
      "source_status": "exact"
    },
    {
      "tableau_calculation": "Tax Amount",
      "source_formula": "SUM([quantity] * [unit_price] * (1 - [discount_pct]) * [tax_rate])",
      "pbi_table": "fact_sales",
      "pbi_object": "Tax Amount",
      "pbi_type": "measure",
      "source_status": "exact"
    },
    {
      "tableau_calculation": "Total Revenue incl Tax",
      "source_formula": "[C_NetRev] + [C_TaxAmt]",
      "pbi_table": "fact_sales",
      "pbi_object": "Total Revenue incl Tax",
      "pbi_type": "measure",
      "source_status": "exact"
    },
    {
      "tableau_calculation": "Return Rate",
      "source_formula": "SUM(IF [is_returned] = TRUE THEN 1 ELSE 0 END) / COUNT([sale_id])",
      "pbi_table": "fact_sales",
      "pbi_object": "Return Rate",
      "pbi_type": "measure",
      "source_status": "exact"
    },
    {
      "tableau_calculation": "Revenue per Customer",
      "source_formula": "{FIXED [customer_id] : SUM([quantity] * [unit_price])}",
      "pbi_table": "fact_sales",
      "pbi_object": "Revenue per Customer",
      "pbi_type": "measure",
      "source_status": "exact"
    },
    {
      "tableau_calculation": "Revenue per Product",
      "source_formula": "{FIXED [product_id] : SUM([quantity] * [unit_price])}",
      "pbi_table": "fact_sales",
      "pbi_object": "Revenue per Product",
      "pbi_type": "measure",
      "source_status": "exact"
    },
    {
      "tableau_calculation": "Revenue by Region-Channel",
      "source_formula": "{FIXED [region], [channel] : SUM([quantity] * [unit_price])}",
      "pbi_table": "fact_sales",
      "pbi_object": "Revenue by Region-Channel",
      "pbi_type": "measure",
      "source_status": "exact"
    },
    {
      "tableau_calculation": "Revenue excl Territory",
      "source_formula": "{EXCLUDE [territory] : SUM([quantity] * [unit_price])}",
      "pbi_table": "fact_sales",
      "pbi_object": "Revenue excl Territory",
      "pbi_type": "measure",
      "source_status": "exact"
    },
    {
      "tableau_calculation": "Revenue incl Subcategory",
      "source_formula": "{INCLUDE [subcategory] : SUM([quantity] * [unit_price])}",
      "pbi_table": "fact_sales",
      "pbi_object": "Revenue incl Subcategory",
      "pbi_type": "measure",
      "source_status": "exact"
    },
    {
      "tableau_calculation": "Running Total Revenue",
      "source_formula": "RUNNING_SUM(SUM([quantity] * [unit_price]))",
      "pbi_table": "fact_sales",
      "pbi_object": "Running Total Revenue",
      "pbi_type": "measure",
      "source_status": "exact"
    },
    {
