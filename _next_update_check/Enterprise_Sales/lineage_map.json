  "calculations": [
    {
      "tableau_calculation": "Gross Revenue",
      "source_formula": "SUM([quantity] * [unit_price])",
      "pbi_table": "Orders",
      "pbi_object": "Gross Revenue",
      "pbi_type": "measure",
      "source_status": "exact"
    },
    {
      "tableau_calculation": "Net Revenue",
      "source_formula": "SUM(IF [order_status] != \"Cancelled\" THEN [quantity] * [unit_price] * (1 - [discount]) ELSE 0 END)",
      "pbi_table": "Orders",
      "pbi_object": "Net Revenue",
      "pbi_type": "measure",
      "source_status": "exact"
    },
    {
      "tableau_calculation": "Total Discount",
      "source_formula": "SUM([quantity] * [unit_price] * [discount])",
      "pbi_table": "Orders",
      "pbi_object": "Total Discount",
      "pbi_type": "measure",
      "source_status": "exact"
    },
    {
      "tableau_calculation": "Profit",
      "source_formula": "SUM(IF [order_status] != \"Cancelled\" THEN ([quantity] * [unit_price] * (1 - [discount])) - [shipping_cost] ELSE 0 END)",
      "pbi_table": "Orders",
      "pbi_object": "Profit",
      "pbi_type": "measure",
      "source_status": "exact"
    },
    {
      "tableau_calculation": "Profit Margin %",
      "source_formula": "[Calc_Profit] / [Calc_NetRevenue]",
      "pbi_table": "Orders",
      "pbi_object": "Profit Margin %",
      "pbi_type": "measure",
      "source_status": "exact"
    },
    {
      "tableau_calculation": "Revenue per Customer",
      "source_formula": "{FIXED [customer_id] : SUM([quantity] * [unit_price])}",
      "pbi_table": "Orders",
      "pbi_object": "Revenue per Customer",
      "pbi_type": "measure",
      "source_status": "exact"
    },
    {
      "tableau_calculation": "Regional Channel Revenue",
      "source_formula": "{FIXED [region], [channel] : SUM([quantity] * [unit_price])}",
      "pbi_table": "Orders",
      "pbi_object": "Regional Channel Revenue",
      "pbi_type": "measure",
      "source_status": "exact"
    },
    {
      "tableau_calculation": "Revenue Excl Category",
      "source_formula": "{EXCLUDE [channel] : SUM([quantity] * [unit_price])}",
      "pbi_table": "Orders",
      "pbi_object": "Revenue Excl Category",
      "pbi_type": "measure",
      "source_status": "exact"
    },
    {
      "tableau_calculation": "Moving Avg Revenue",
      "source_formula": "WINDOW_AVG(SUM([quantity] * [unit_price]))",
      "pbi_table": "Orders",
      "pbi_object": "Moving Avg Revenue",
      "pbi_type": "measure",
      "source_status": "exact"
    },
    {
      "tableau_calculation": "Running Total Revenue",
      "source_formula": "RUNNING_SUM(SUM([quantity] * [unit_price]))",
      "pbi_table": "Orders",
      "pbi_object": "Running Total Revenue",
      "pbi_type": "measure",
      "source_status": "exact"
    },
    {
      "tableau_calculation": "Revenue Rank",
      "source_formula": "RANK(SUM([quantity] * [unit_price]))",
      "pbi_table": "Orders",
      "pbi_object": "Revenue Rank",
      "pbi_type": "measure",
      "source_status": "exact"
    },
    {
      "tableau_calculation": "YTD Revenue",
      "source_formula": "{FIXED : SUM(IF YEAR([order_date]) = YEAR(TODAY()) THEN [quantity] * [unit_price] ELSE 0 END)}",
      "pbi_table": "Orders",
      "pbi_object": "YTD Revenue",
      "pbi_type": "measure",
      "source_status": "exact"
    },
    {
      "tableau_calculation": "Customer Tier",
      "source_formula": "IF [Calc_RevPerCustomer] > 10000 THEN \"Platinum\" ELSEIF [Calc_RevPerCustomer] > 5000 THEN \"Gold\" ELSEIF [Calc_RevPerCustomer] > 1000 THEN \"Silver\" ELSE \"Bronze\" END",
      "pbi_table": "Orders",
      "pbi_object": "Customer Tier",
      "pbi_type": "measure",
      "source_status": "exact"
    },
    {
      "tableau_calculation": "Unique Customers",
      "source_formula": "COUNTD([customer_id])",
      "pbi_table": "Orders",
      "pbi_object": "Unique Customers",
      "pbi_type": "measure",
      "source_status": "exact"
    },
    {
      "tableau_calculation": "AOV Completed",
      "source_formula": "AVG(IF [order_status] = \"Completed\" THEN [quantity] * [unit_price] ELSE 0 END)",
      "pbi_table": "Orders",
      "pbi_object": "AOV Completed",
      "pbi_type": "measure",
      "source_status": "exact"
    },
    {
      "tableau_calculation": "Revenue StdDev",
      "source_formula": "STDEV(SUM([quantity] * [unit_price]))",
