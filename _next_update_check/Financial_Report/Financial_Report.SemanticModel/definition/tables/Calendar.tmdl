	hierarchy 'Date Hierarchy'
		lineageTag: a55a88dc-41f9-4f34-86c5-01cf02e946bb

		level Year
			ordinal: 0
			column: Year
			lineageTag: 962d1ef8-4666-45ae-9a04-dafd22219452

		level Quarter
			ordinal: 1
			column: Quarter
